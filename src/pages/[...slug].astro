---
import MirrorDocument from "../layouts/MirrorDocument.astro";
import { getMirrorRouteSlugs, readMirrorDocumentBySlug } from "../lib/mirror";

export function getStaticPaths() {
  return getMirrorRouteSlugs().map((slug) => ({
    params: { slug },
    props: { slug },
  }));
}

const { slug } = Astro.props as { slug: string };
const document = readMirrorDocumentBySlug(slug);
---

<MirrorDocument
  htmlAttributes={document.htmlAttributes}
  headInnerHtml={document.headInnerHtml}
  bodyAttributes={document.bodyAttributes}
  bodyInnerHtml={document.bodyInnerHtml}
/>
