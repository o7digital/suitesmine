---
type Props = {
  htmlAttributes?: Record<string, string | boolean>;
  headInnerHtml: string;
  bodyAttributes?: Record<string, string | boolean>;
  bodyInnerHtml: string;
};

const {
  htmlAttributes = {},
  headInnerHtml,
  bodyAttributes = {},
  bodyInnerHtml,
} = Astro.props as Props;

const GA_MEASUREMENT_ID = "G-F2QTNE0PJ1";
const hasGoogleAnalytics = headInnerHtml.includes(GA_MEASUREMENT_ID);
const OLIVIA_CLIENT_CODE = "suitesmine";
const OLIVIA_CLIENT_NAME = "Suites Mine";
const OLIVIA_CHANNEL_ENDPOINT = import.meta.env.PUBLIC_OLIVIA_CHANNEL_ENDPOINT ?? "";
const oliviaInitialLanguage = String(htmlAttributes.lang ?? "").toLowerCase().startsWith("en")
  ? "en"
  : "es";
---

<html {...htmlAttributes}>
  <head>
    <Fragment set:html={headInnerHtml} />
    {!hasGoogleAnalytics && (
      <>
        <script async src={`https://www.googletagmanager.com/gtag/js?id=${GA_MEASUREMENT_ID}`}></script>
        <script is:inline define:vars={{ GA_MEASUREMENT_ID }}>
          window.dataLayer = window.dataLayer || [];
          function gtag(){dataLayer.push(arguments);}
          gtag('js', new Date());

          gtag('config', GA_MEASUREMENT_ID);
        </script>
      </>
    )}
  </head>
  <body {...bodyAttributes}>
    <Fragment set:html={bodyInnerHtml} />
    <div
      id="olivia-widget"
      class="olivia-widget"
      data-client-code={OLIVIA_CLIENT_CODE}
      data-client-name={OLIVIA_CLIENT_NAME}
      data-language={oliviaInitialLanguage}
    >
      <button class="olivia-launcher" type="button" aria-label="Abrir Olivia IA">
        <span class="olivia-launcher__mark">O</span>
        <span class="olivia-launcher__text">Olivia IA</span>
      </button>

      <section class="olivia-panel" aria-label="Chat Olivia IA" hidden>
        <header class="olivia-header">
          <div>
            <p class="olivia-kicker">Suites Mine</p>
            <h2>Olivia IA</h2>
          </div>
          <button class="olivia-close" type="button" aria-label="Cerrar Olivia IA">×</button>
        </header>

        <div class="olivia-messages" aria-live="polite">
          <div class="olivia-message olivia-message--assistant">
            Hola, soy Olivia IA. Puedo ayudarle con disponibilidad, tarifas y solicitudes de reserva.
          </div>
        </div>

        <form class="olivia-form">
          <div class="olivia-fields">
            <label>
              <span data-olivia-i18n="checkIn">Llegada</span>
              <input name="checkIn" type="date" />
            </label>
            <label>
              <span data-olivia-i18n="checkOut">Salida</span>
              <input name="checkOut" type="date" />
            </label>
            <label>
              <span data-olivia-i18n="guests">Huespedes</span>
              <input name="guests" type="number" min="1" placeholder="2" />
            </label>
          </div>
          <div class="olivia-composer">
            <input
              name="message"
              type="text"
              autocomplete="off"
              placeholder="Escriba su pregunta..."
              required
            />
            <button type="submit">Enviar</button>
          </div>
        </form>
      </section>
    </div>

    <style is:inline>
      .olivia-widget {
        position: fixed;
        right: 22px;
        bottom: 22px;
        z-index: 99999;
        font-family: ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
      }

      .olivia-launcher {
        display: flex;
        align-items: center;
        gap: 10px;
        min-height: 56px;
        border: 0;
        border-radius: 999px;
        padding: 8px 18px 8px 8px;
        background: #1f2a44;
        color: white;
        box-shadow: 0 22px 60px rgba(12, 20, 38, 0.28);
        cursor: pointer;
      }

      .olivia-launcher__mark {
        display: grid;
        place-items: center;
        width: 40px;
        height: 40px;
        border-radius: 50%;
        background: #ffffff;
        color: #1f2a44;
        font-weight: 800;
      }

      .olivia-launcher__text {
        font-size: 15px;
        font-weight: 700;
      }

      .olivia-panel {
        width: min(420px, calc(100vw - 28px));
        height: min(680px, calc(100vh - 28px));
        overflow: hidden;
        border: 1px solid rgba(31, 42, 68, 0.14);
        border-radius: 18px;
        background: #ffffff;
        box-shadow: 0 30px 90px rgba(12, 20, 38, 0.28);
      }

      .olivia-panel[hidden] {
        display: none;
      }

      .olivia-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 18px;
        background: #1f2a44;
        color: white;
      }

      .olivia-kicker,
      .olivia-header h2 {
        margin: 0;
      }

      .olivia-kicker {
        color: rgba(255, 255, 255, 0.72);
        font-size: 12px;
        font-weight: 700;
        text-transform: uppercase;
      }

      .olivia-header h2 {
        margin-top: 2px;
        font-size: 20px;
        line-height: 1.2;
      }

      .olivia-close {
        display: grid;
        place-items: center;
        width: 36px;
        height: 36px;
        border: 0;
        border-radius: 50%;
        background: rgba(255, 255, 255, 0.12);
        color: white;
        cursor: pointer;
        font-size: 24px;
        line-height: 1;
      }

      .olivia-messages {
        display: flex;
        flex-direction: column;
        gap: 10px;
        height: calc(100% - 236px);
        overflow-y: auto;
        padding: 16px;
        background: #f6f4ee;
      }

      .olivia-message {
        max-width: 86%;
        border-radius: 14px;
        padding: 11px 13px;
        font-size: 14px;
        line-height: 1.45;
        white-space: pre-line;
      }

      .olivia-message--assistant {
        align-self: flex-start;
        background: white;
        color: #222833;
        border: 1px solid rgba(31, 42, 68, 0.1);
      }

      .olivia-message--user {
        align-self: flex-end;
        background: #1f2a44;
        color: white;
      }

      .olivia-form {
        border-top: 1px solid rgba(31, 42, 68, 0.12);
        background: white;
        padding: 12px;
      }

      .olivia-fields {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 8px;
        margin-bottom: 10px;
      }

      .olivia-fields label {
        display: flex;
        min-width: 0;
        flex-direction: column;
        gap: 4px;
        color: #5f6675;
        font-size: 11px;
        font-weight: 700;
      }

      .olivia-fields input,
      .olivia-composer input {
        min-width: 0;
        border: 1px solid rgba(31, 42, 68, 0.18);
        border-radius: 10px;
        background: #fbfbfd;
        color: #1f2a44;
        outline: 0;
      }

      .olivia-fields input {
        height: 36px;
        padding: 0 8px;
        font-size: 12px;
      }

      .olivia-composer {
        display: flex;
        gap: 8px;
      }

      .olivia-composer input {
        flex: 1;
        height: 44px;
        padding: 0 12px;
        font-size: 14px;
      }

      .olivia-composer button {
        border: 0;
        border-radius: 10px;
        padding: 0 14px;
        background: #b88a44;
        color: white;
        cursor: pointer;
        font-size: 13px;
        font-weight: 800;
      }

      @media (max-width: 540px) {
        .olivia-widget {
          right: 14px;
          bottom: 14px;
        }

        .olivia-panel {
          height: min(640px, calc(100vh - 28px));
        }

        .olivia-fields {
          grid-template-columns: 1fr;
        }

        .olivia-messages {
          height: calc(100% - 330px);
        }
      }
    </style>

    <script is:inline define:vars={{ OLIVIA_CLIENT_CODE, OLIVIA_CLIENT_NAME, OLIVIA_CHANNEL_ENDPOINT }}>
      (() => {
        const widget = document.getElementById("olivia-widget");
        if (!widget || widget.dataset.ready === "true") return;
        widget.dataset.ready = "true";

        const language = window.location.pathname.startsWith("/en") ? "en" : "es";
        const copy = {
          es: {
            launcherLabel: "Abrir Olivia IA",
            panelLabel: "Chat Olivia IA",
            closeLabel: "Cerrar Olivia IA",
            checkIn: "Llegada",
            checkOut: "Salida",
            guests: "Huespedes",
            placeholder: "Escriba su pregunta...",
            send: "Enviar",
            welcome:
              "Hola, soy Olivia IA. Conozco Suites Mine y puedo responder sobre habitaciones, ubicación, servicios, tarifas y disponibilidad.",
            sent: "Perfecto. Tambien he enviado su solicitud al equipo de Suites Mine para seguimiento.",
            fallback: "Puedo ayudarle con Suites Mine: disponibilidad, tarifas, habitaciones, ubicacion, servicios y contacto.",
            needDates: "Claro. Indiqueme fecha de llegada, salida y numero de huespedes para revisar disponibilidad.",
            availability:
              "Para 09/06/2026 al 12/06/2026 tengo estas opciones de referencia:\n\nEstudio: 21 disponibles, 1700 MXN por noche, total 5100 MXN.\nSuite: 14 disponibles, 1900 MXN por noche, total 5700 MXN.\nSuite Doble: 4 disponibles, 2100 MXN por noche, total 6300 MXN.\n\nPuedo ayudarle a elegir la mejor opcion segun sus huespedes.",
            rooms:
              "Suites Mine cuenta con 39 suites tipo apartamento: Estudio, Suite y Suite Doble. La Suite Doble es la opcion mas amplia para hasta 4 huespedes.",
            location:
              "Suites Mine esta en Rio Ebro 64, Colonia Cuauhtemoc, CDMX 06500, Mexico. Es una zona centrica, cerca del Angel de la Independencia.",
            services:
              "El hotel ofrece suites tipo apartamento, Wi-Fi, recepcion/atencion, terraza, restaurante/bar y opciones con jacuzzi segun disponibilidad.",
            contact:
              "Puede contactar a Suites Mine en contacto@suitesmine.com o por telefono al +52 55 3666 8535.",
            booking:
              "Para reservar, digame sus fechas, numero de huespedes y tipo de habitacion preferida. Si desea, tambien puedo pasar la solicitud al equipo.",
            human:
              "Entendido. Para que una persona tome el control, deje su solicitud aqui y el equipo de Suites Mine podra dar seguimiento.",
          },
          en: {
            launcherLabel: "Open Olivia IA",
            panelLabel: "Olivia IA chat",
            closeLabel: "Close Olivia IA",
            checkIn: "Check in",
            checkOut: "Check out",
            guests: "Guests",
            placeholder: "Ask your question...",
            send: "Send",
            welcome:
              "Hello, I am Olivia IA. I know Suites Mine and can answer questions about rooms, location, services, rates and availability.",
            sent: "Perfect. I also sent your request to the Suites Mine team for follow-up.",
            fallback: "I can help with Suites Mine: availability, rates, rooms, location, services and contact details.",
            needDates: "Of course. Please share check-in date, check-out date and number of guests so I can check availability.",
            availability:
              "For June 9, 2026 to June 12, 2026, I have these reference options:\n\nStudio: 21 available, MXN 1700 per night, total MXN 5100.\nSuite: 14 available, MXN 1900 per night, total MXN 5700.\nDouble Suite: 4 available, MXN 2100 per night, total MXN 6300.\n\nI can help you choose the best option for your guests.",
            rooms:
              "Suites Mine has 39 apartment-style suites: Studio, Suite and Double Suite. The Double Suite is the largest option, for up to 4 guests.",
            location:
              "Suites Mine is located at Rio Ebro 64, Colonia Cuauhtemoc, CDMX 06500, Mexico, near the Angel of Independence.",
            services:
              "The hotel offers apartment-style suites, Wi-Fi, guest support, terrace, restaurant/bar and jacuzzi options depending on availability.",
            contact:
              "You can contact Suites Mine at contacto@suitesmine.com or by phone at +52 55 3666 8535.",
            booking:
              "To reserve, tell me your dates, number of guests and preferred room type. I can also pass the request to the team.",
            human:
              "Understood. If you want a person to take over, leave your request here and the Suites Mine team can follow up.",
          },
        }[language];

        const hotelKnowledge = {
          bookingUrl:
            language === "en"
              ? "https://hotels.cloudbeds.com/en/reservation/DzS8Bc?currency=mxn"
              : "https://hotels.cloudbeds.com/es/reservation/DzS8Bc?currency=mxn",
        };

        const faqAnswers = {
          es: [
            {
              words: ["aire acondicionado", "ac", "calor", "frio", "ventilador"],
              answer:
                "Las habitaciones no cuentan con aire acondicionado. Suites Mine proporciona ventiladores portatiles, enfriadores de aire con agua y calentadores bajo peticion. Las habitaciones tienen ventanales de doble vidrio para aislamiento de ruido y mejor control termico.",
            },
            {
              words: ["estacionamiento", "parking", "parqueo", "auto", "coche", "carro"],
              answer:
                "El estacionamiento es pequeno, gratuito y sujeto a disponibilidad. Se da acceso conforme llegan los vehiculos. Si esta lleno, hay estacionamientos publicos cercanos o calle con parquimetro de lunes a viernes de 8:00 am a 8:00 pm.",
            },
            {
              words: ["mascota", "mascotas", "pet", "perro", "gato"],
              answer: "Suites Mine no acepta mascotas de ningun tipo.",
            },
            {
              words: ["nino", "ninos", "menor", "menores", "children", "kids", "bebe"],
              answer:
                "No se aceptan ninos menores de 6 anos. A partir de 6 anos se consideran como un huesped mas y aplica tarifa de adulto.",
            },
            {
              words: ["early", "temprano", "late", "tardio", "check in", "check-in", "check out", "check-out", "salida tarde", "llegada temprano"],
              answer:
                "El check-in regular es de 2:00 pm a 12:30 am del dia siguiente. Early check-in solo puede solicitarse despues de las 6:00 pm del dia previo, sujeto a disponibilidad y con tarifa fija, desde las 9:00 am. Late check-out tambien se solicita un dia antes despues de las 6:00 pm, sujeto a disponibilidad, con salida maxima a las 4:00 pm y tarifa fija.",
            },
            {
              words: ["madrugada", "24 horas", "24h", "noche previa", "llego tarde"],
              answer:
                "Suites Mine no opera 24 horas. Si llega fuera del horario de check-in, de 2:00 pm a 12:30 am, se recomienda elegir un alojamiento con operacion 24 horas.",
            },
            {
              words: ["equipaje", "maleta", "maletas", "luggage", "guardar"],
              answer:
                "El resguardo de equipaje es gratuito el mismo dia del check-in o check-out. El horario es de 9:00 am a 10:00 pm. Para guardar equipaje por varios dias, aplica una tarifa fija por dia y por maleta/bolsa/mochila.",
            },
            {
              words: ["movilidad", "discapacidad", "accesible", "silla", "elevador", "adulto mayor"],
              answer:
                "Algunos Estudios del primer piso tienen aditamentos para movilidad reducida, como barras de seguridad y silla para regadera. Para entrar hay alrededor de 10 escalones; desde estacionamiento subterraneo hay acceso a elevador. Para necesidades especiales, conviene reservar por telefono al +52 55 3666 8535.",
            },
            {
              words: ["hotel", "airbnb", "recepcion 24", "concierge", "desayuno", "aeropuerto"],
              answer:
                "Suites Mine es un servicio de hospedaje alterno tipo apartahotel, no un hotel tradicional. No ofrece recepcion 24 horas, concierge, botones, desayuno incluido ni transporte aeropuerto. Si ofrece limpieza diaria, guardaequipaje, Wi-Fi de alta velocidad, TV de paga, vigilancia, recepcion y amenidades.",
            },
            {
              words: ["diferencia", "tipo", "tipos", "estudio", "suite", "doble", "habitaciones"],
              answer:
                "Los Estudios son la opcion mas economica, con cocineta parcial. Las Suites tienen cocina mas equipada con parrilla, campana, ollas y sartenes. Estudios y Suites alojan hasta 3 huespedes. Las Suites Dobles son mas amplias, tienen 2 camas queen size, cocina completa y capacidad hasta 4 huespedes.",
            },
            {
              words: ["amenidades", "rooftop", "terraza", "jacuzzi", "bar", "gimnasio", "comida"],
              answer:
                "Suites Mine cuenta con rooftop abierto todos los dias de 10:30 am a 10:00 pm, jacuzzi comun para 8 personas, sala pequena, camastros, mesas, bar, banos con regadera y comida a la carta. El gimnasio esta previsto para la sucursal.",
            },
            {
              words: ["descuento", "larga estancia", "semana", "mes", "mensual", "long stay"],
              answer:
                "Hay tarifa por noche, descuento de 10% para semana desde 7 noches consecutivas en la misma habitacion, y descuento de 20% para mes desde 30 noches consecutivas. Disponible en web oficial y por telefono.",
            },
            {
              words: ["pago", "tarjeta", "efectivo", "transferencia", "visa", "mastercard", "amex"],
              answer:
                "Aceptan efectivo en pesos mexicanos y tarjetas Visa, MasterCard, Carnet y American Express. En reservas anticipadas por telefono se puede solicitar transferencia bancaria nacional o link de pago virtual.",
            },
            {
              words: ["factura", "facturacion", "iva", "sat"],
              answer:
                "La mayoria de reservas pueden facturarse con IVA desglosado. Se requiere Constancia de Situacion Fiscal del SAT y correo electronico durante la estancia. Para huesped extranjero puede solicitarse recibo no certificado por el SAT.",
            },
          ],
          en: [
            {
              words: ["air conditioning", "ac", "heat", "cold", "fan"],
              answer:
                "Rooms do not have air conditioning. Suites Mine can provide portable fans, water air coolers and heaters on request. Rooms have double-glazed windows for noise insulation and better thermal control.",
            },
            {
              words: ["parking", "car", "vehicle"],
              answer:
                "Parking is small, free and subject to availability. Vehicles are admitted as they arrive. If full, guests can use nearby public parking or metered street parking Monday to Friday from 8:00 am to 8:00 pm.",
            },
            {
              words: ["pet", "pets", "dog", "cat"],
              answer: "Suites Mine does not accept pets of any kind.",
            },
            {
              words: ["child", "children", "kid", "kids", "minor", "baby"],
              answer:
                "Children under 6 are not accepted. Children from 6 years old count as one more guest and adult rates apply.",
            },
            {
              words: ["early", "late", "check in", "check-in", "check out", "check-out"],
              answer:
                "Regular check-in is from 2:00 pm to 12:30 am the next day. Early check-in can only be requested after 6:00 pm the day before arrival, subject to availability and a fixed fee, from 9:00 am. Late check-out is also requested one day before after 6:00 pm, subject to availability, with maximum departure at 4:00 pm and a fixed fee.",
            },
            {
              words: ["midnight", "24 hours", "24h", "late arrival"],
              answer:
                "Suites Mine does not operate 24 hours. If you arrive outside check-in hours, from 2:00 pm to 12:30 am, the property recommends choosing accommodation with 24-hour operation.",
            },
            {
              words: ["luggage", "bag", "bags", "storage"],
              answer:
                "Luggage storage is free on the same day as check-in or check-out. Service hours are 9:00 am to 10:00 pm. For storage over several days, a fixed daily fee applies per suitcase/bag/backpack.",
            },
            {
              words: ["mobility", "accessible", "accessibility", "wheelchair", "elevator", "senior"],
              answer:
                "Some first-floor Studios have light accessibility aids such as shower safety bars and a shower chair. Entry requires about 10 steps; from underground parking there is elevator access. For special needs, book by phone at +52 55 3666 8535.",
            },
            {
              words: ["hotel", "airbnb", "24-hour reception", "concierge", "breakfast", "airport"],
              answer:
                "Suites Mine is an alternative lodging service, similar to an aparthotel, not a traditional hotel. It does not offer 24-hour reception, concierge, bell service, included breakfast or airport transfer. It does offer daily cleaning, luggage storage, high-speed Wi-Fi, paid TV, security, reception and amenities.",
            },
            {
              words: ["difference", "type", "studio", "suite", "double", "rooms"],
              answer:
                "Studios are the most economical option and include a partial kitchenette. Suites have a more complete kitchen with electric grill, hood, pots and pans. Studios and Suites host up to 3 guests. Double Suites are larger, with 2 queen beds, full kitchen and capacity up to 4 guests.",
            },
            {
              words: ["amenities", "rooftop", "terrace", "jacuzzi", "bar", "gym", "food"],
              answer:
                "Suites Mine has a rooftop open daily from 10:30 am to 10:00 pm, a common jacuzzi for 8 people, small lounge, sunbeds, tables, bar, bathrooms with shower and a la carte food service. A gym is planned for the branch.",
            },
            {
              words: ["discount", "long stay", "week", "month", "monthly"],
              answer:
                "There is a nightly rate, a 10% weekly discount from 7 consecutive nights in the same room, and a 20% monthly discount from 30 consecutive nights. These discounts are available on the official website and by phone.",
            },
            {
              words: ["payment", "card", "cash", "transfer", "visa", "mastercard", "amex"],
              answer:
                "Suites Mine accepts cash in Mexican pesos and Visa, MasterCard, Carnet and American Express credit/debit cards. For advance phone reservations, national bank transfer or virtual payment link may be requested.",
            },
            {
              words: ["invoice", "billing", "vat", "tax"],
              answer:
                "Most reservations can be invoiced with itemized VAT. A Mexican SAT Tax Status Certificate and email are required during the stay. Foreign guests can request a non-SAT-certified receipt.",
            },
          ],
        }[language];

        const launcher = widget.querySelector(".olivia-launcher");
        const panel = widget.querySelector(".olivia-panel");
        const closeButton = widget.querySelector(".olivia-close");
        const form = widget.querySelector(".olivia-form");
        const messages = widget.querySelector(".olivia-messages");
        const firstMessage = widget.querySelector(".olivia-message--assistant");
        const messageInput = widget.querySelector('input[name="message"]');
        const submitButton = widget.querySelector('.olivia-composer button[type="submit"]');

        launcher?.setAttribute("aria-label", copy.launcherLabel);
        panel?.setAttribute("aria-label", copy.panelLabel);
        closeButton?.setAttribute("aria-label", copy.closeLabel);
        widget.querySelector('[data-olivia-i18n="checkIn"]').textContent = copy.checkIn;
        widget.querySelector('[data-olivia-i18n="checkOut"]').textContent = copy.checkOut;
        widget.querySelector('[data-olivia-i18n="guests"]').textContent = copy.guests;
        if (firstMessage) firstMessage.textContent = copy.welcome;
        if (messageInput) messageInput.placeholder = copy.placeholder;
        if (submitButton) submitButton.textContent = copy.send;

        function addOliviaMessage(content, role) {
          const message = document.createElement("div");
          message.className = `olivia-message olivia-message--${role}`;
          message.textContent = content;
          messages?.appendChild(message);
          messages?.scrollTo({ top: messages.scrollHeight, behavior: "smooth" });
        }

        function normalizeText(value) {
          return value
            .toLowerCase()
            .normalize("NFD")
            .replace(/[\u0300-\u036f]/g, "");
        }

        function hasAny(text, words) {
          return words.some((word) => text.includes(word));
        }

        function answerFromSiteKnowledge(text, metadata) {
          const normalized = normalizeText(text);
          const hasDates = Boolean(metadata.checkIn && metadata.checkOut);

          if (hasAny(normalized, ["humano", "persona", "agente", "asesor", "equipo", "manual", "take over", "human", "agent"])) {
            return copy.human;
          }

          if (hasAny(normalized, ["dispo", "available", "availability", "tarifa", "precio", "rate", "price", "reserva", "reservar", "booking", "book", "habitacion", "room"])) {
            if (hasAny(normalized, ["habitacion", "room", "suite", "estudio", "studio"]) && !hasAny(normalized, ["dispo", "available", "availability", "tarifa", "precio", "rate", "price", "reserva", "booking", "book"])) {
              return copy.rooms;
            }
            if (!hasDates && hasAny(normalized, ["dispo", "available", "availability", "tarifa", "precio", "rate", "price"])) {
              return copy.needDates;
            }
            return `${copy.availability}\n\n${language === "en" ? "Booking link:" : "Link de reserva:"} ${hotelKnowledge.bookingUrl}`;
          }

          const faqAnswer = faqAnswers.find((item) => hasAny(normalized, item.words));
          if (faqAnswer) return faqAnswer.answer;

          if (hasAny(normalized, ["ubicacion", "direccion", "donde", "location", "address", "where", "angel", "cuauhtemoc"])) {
            return copy.location;
          }

          if (hasAny(normalized, ["servicio", "amenidad", "wifi", "terraza", "jacuzzi", "restaurant", "bar", "service", "amenity"])) {
            return copy.services;
          }

          if (hasAny(normalized, ["contacto", "telefono", "email", "correo", "phone", "mail", "contact"])) {
            return copy.contact;
          }

          if (hasAny(normalized, ["hola", "hello", "hi", "buenos", "buenas"])) {
            return copy.welcome;
          }

          return copy.fallback;
        }

        launcher?.addEventListener("click", () => {
          panel.hidden = false;
          launcher.hidden = true;
        });

        closeButton?.addEventListener("click", () => {
          panel.hidden = true;
          launcher.hidden = false;
        });

        form?.addEventListener("submit", async (event) => {
          event.preventDefault();
          const formData = new FormData(form);
          const text = String(formData.get("message") || "").trim();
          if (!text) return;

          addOliviaMessage(text, "user");
          if (messageInput) messageInput.value = "";

          const payload = {
            clientCode: OLIVIA_CLIENT_CODE,
            clientName: OLIVIA_CLIENT_NAME,
            source: "website",
            language,
            pageUrl: window.location.href,
            message: text,
            metadata: {
              checkIn: formData.get("checkIn") || "",
              checkOut: formData.get("checkOut") || "",
              guests: formData.get("guests") || "",
            },
            createdAt: new Date().toISOString(),
          };
          const answer = answerFromSiteKnowledge(text, payload.metadata);

          try {
            if (OLIVIA_CHANNEL_ENDPOINT) {
              await fetch(OLIVIA_CHANNEL_ENDPOINT, {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify(payload),
              });
            }
            addOliviaMessage(answer, "assistant");
          } catch {
            addOliviaMessage(answer, "assistant");
          }
        });
      })();
    </script>
  </body>
</html>
