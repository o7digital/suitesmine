---
type Props = {
  htmlAttributes?: Record<string, string | boolean>;
  headInnerHtml: string;
  bodyAttributes?: Record<string, string | boolean>;
  bodyInnerHtml: string;
};

const {
  htmlAttributes = {},
  headInnerHtml,
  bodyAttributes = {},
  bodyInnerHtml,
} = Astro.props as Props;

const GA_MEASUREMENT_ID = "G-F2QTNE0PJ1";
const hasGoogleAnalytics = headInnerHtml.includes(GA_MEASUREMENT_ID);
const OLIVIA_CLIENT_CODE = "suitesmine";
const OLIVIA_CLIENT_NAME = "Suites Mine";
const OLIVIA_CHANNEL_ENDPOINT =
  import.meta.env.PUBLIC_OLIVIA_CHANNEL_ENDPOINT ??
  "https://suitesmine-bot.vercel.app/api/olivia/chat";
const oliviaInitialLanguage = String(htmlAttributes.lang ?? "").toLowerCase().startsWith("en")
  ? "en"
  : "es";
---

<html {...htmlAttributes}>
  <head>
    <Fragment set:html={headInnerHtml} />
    {!hasGoogleAnalytics && (
      <>
        <script async src={`https://www.googletagmanager.com/gtag/js?id=${GA_MEASUREMENT_ID}`}></script>
        <script is:inline define:vars={{ GA_MEASUREMENT_ID }}>
          window.dataLayer = window.dataLayer || [];
          function gtag(){dataLayer.push(arguments);}
          gtag('js', new Date());

          gtag('config', GA_MEASUREMENT_ID);
        </script>
      </>
    )}
  </head>
  <body {...bodyAttributes}>
    <Fragment set:html={bodyInnerHtml} />
    <div
      id="olivia-widget"
      class="olivia-widget"
      data-client-code={OLIVIA_CLIENT_CODE}
      data-client-name={OLIVIA_CLIENT_NAME}
      data-language={oliviaInitialLanguage}
    >
      <button class="olivia-launcher" type="button" aria-label="Abrir Olivia IA Concierge">
        <span class="olivia-launcher__mark">O</span>
        <span class="olivia-launcher__text">Olivia IA Concierge</span>
      </button>

      <section class="olivia-panel" aria-label="Chat Olivia IA Concierge" hidden>
        <header class="olivia-header">
          <div>
            <p class="olivia-kicker">Suites Mine</p>
            <h2>Olivia IA Concierge</h2>
          </div>
          <button class="olivia-close" type="button" aria-label="Cerrar Olivia IA Concierge">×</button>
        </header>

        <div class="olivia-messages" aria-live="polite">
          <div class="olivia-message olivia-message--assistant">
            Hola, soy Olivia IA Concierge. Puedo ayudarle con disponibilidad, tarifas y solicitudes de reserva.
          </div>
        </div>

        <form class="olivia-form">
          <div class="olivia-fields">
            <label>
              <span data-olivia-i18n="checkIn">Llegada</span>
              <input name="checkIn" type="date" />
            </label>
            <label>
              <span data-olivia-i18n="checkOut">Salida</span>
              <input name="checkOut" type="date" />
            </label>
            <label>
              <span data-olivia-i18n="guests">Huespedes</span>
              <input name="guests" type="number" min="1" placeholder="2" />
            </label>
          </div>
          <div class="olivia-composer">
            <input
              name="message"
              type="text"
              autocomplete="off"
              placeholder="Escriba su pregunta..."
              required
            />
            <button type="submit">Enviar</button>
          </div>
        </form>
      </section>
    </div>

    <style is:inline>
      .olivia-widget {
        position: fixed;
        right: 22px;
        bottom: 22px;
        z-index: 99999;
        font-family: ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
      }

      .olivia-launcher {
        display: flex;
        align-items: center;
        gap: 10px;
        min-height: 56px;
        border: 0;
        border-radius: 999px;
        padding: 8px 18px 8px 8px;
        background: #1f2a44;
        color: white;
        box-shadow: 0 22px 60px rgba(12, 20, 38, 0.28);
        cursor: pointer;
      }

      .olivia-launcher__mark {
        display: grid;
        place-items: center;
        width: 40px;
        height: 40px;
        border-radius: 50%;
        background: #ffffff;
        color: #1f2a44;
        font-weight: 800;
      }

      .olivia-launcher__text {
        font-size: 15px;
        font-weight: 700;
      }

      .olivia-panel {
        width: min(420px, calc(100vw - 28px));
        height: min(680px, calc(100vh - 28px));
        overflow: hidden;
        border: 1px solid rgba(31, 42, 68, 0.14);
        border-radius: 18px;
        background: #ffffff;
        box-shadow: 0 30px 90px rgba(12, 20, 38, 0.28);
      }

      .olivia-panel[hidden] {
        display: none;
      }

      .olivia-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 18px;
        background: #1f2a44;
        color: white;
      }

      .olivia-kicker,
      .olivia-header h2 {
        margin: 0;
      }

      .olivia-kicker {
        color: rgba(255, 255, 255, 0.72);
        font-size: 12px;
        font-weight: 700;
        text-transform: uppercase;
      }

      .olivia-header h2 {
        margin-top: 2px;
        font-size: 20px;
        line-height: 1.2;
      }

      .olivia-close {
        display: grid;
        place-items: center;
        width: 36px;
        height: 36px;
        border: 0;
        border-radius: 50%;
        background: rgba(255, 255, 255, 0.12);
        color: white;
        cursor: pointer;
        font-size: 24px;
        line-height: 1;
      }

      .olivia-messages {
        display: flex;
        flex-direction: column;
        gap: 10px;
        height: calc(100% - 236px);
        overflow-y: auto;
        padding: 16px;
        background: #f6f4ee;
      }

      .olivia-message {
        max-width: 86%;
        border-radius: 14px;
        padding: 11px 13px;
        font-size: 14px;
        line-height: 1.45;
        white-space: pre-line;
      }

      .olivia-message--assistant {
        align-self: flex-start;
        background: white;
        color: #222833;
        border: 1px solid rgba(31, 42, 68, 0.1);
      }

      .olivia-message--user {
        align-self: flex-end;
        background: #1f2a44;
        color: white;
      }

      .olivia-message--typing {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        width: fit-content;
        min-width: 56px;
      }

      .olivia-message--typing span {
        width: 6px;
        height: 6px;
        border-radius: 50%;
        background: #6f7685;
        animation: oliviaTyping 1s infinite ease-in-out;
      }

      .olivia-message--typing span:nth-child(2) {
        animation-delay: 0.15s;
      }

      .olivia-message--typing span:nth-child(3) {
        animation-delay: 0.3s;
      }

      @keyframes oliviaTyping {
        0%,
        80%,
        100% {
          opacity: 0.35;
          transform: translateY(0);
        }

        40% {
          opacity: 1;
          transform: translateY(-3px);
        }
      }

      .olivia-form {
        border-top: 1px solid rgba(31, 42, 68, 0.12);
        background: white;
        padding: 12px;
      }

      .olivia-fields {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 8px;
        margin-bottom: 10px;
      }

      .olivia-fields label {
        display: flex;
        min-width: 0;
        flex-direction: column;
        gap: 4px;
        color: #5f6675;
        font-size: 11px;
        font-weight: 700;
      }

      .olivia-fields input,
      .olivia-composer input {
        min-width: 0;
        border: 1px solid rgba(31, 42, 68, 0.18);
        border-radius: 10px;
        background: #fbfbfd;
        color: #1f2a44;
        outline: 0;
      }

      .olivia-fields input {
        height: 36px;
        padding: 0 8px;
        font-size: 12px;
      }

      .olivia-composer {
        display: flex;
        gap: 8px;
      }

      .olivia-composer input {
        flex: 1;
        height: 44px;
        padding: 0 12px;
        font-size: 14px;
      }

      .olivia-composer button {
        border: 0;
        border-radius: 10px;
        padding: 0 14px;
        background: #b88a44;
        color: white;
        cursor: pointer;
        font-size: 13px;
        font-weight: 800;
      }

      @media (max-width: 540px) {
        .olivia-widget {
          right: 14px;
          bottom: 14px;
        }

        .olivia-panel {
          height: min(640px, calc(100vh - 28px));
        }

        .olivia-fields {
          grid-template-columns: 1fr;
        }

        .olivia-messages {
          height: calc(100% - 330px);
        }
      }
    </style>

    <script is:inline define:vars={{ OLIVIA_CLIENT_CODE, OLIVIA_CLIENT_NAME, OLIVIA_CHANNEL_ENDPOINT }}>
