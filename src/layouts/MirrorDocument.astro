---
type Props = {
  htmlAttributes?: Record<string, string | boolean>;
  headInnerHtml: string;
  bodyAttributes?: Record<string, string | boolean>;
  bodyInnerHtml: string;
};

const {
  htmlAttributes = {},
  headInnerHtml,
  bodyAttributes = {},
  bodyInnerHtml,
} = Astro.props as Props;

const GA_MEASUREMENT_ID = "G-F2QTNE0PJ1";
const hasGoogleAnalytics = headInnerHtml.includes(GA_MEASUREMENT_ID);
const OLIVIA_CLIENT_CODE = "suitesmine";
const OLIVIA_CLIENT_NAME = "Suites Mine";
const OLIVIA_CHANNEL_ENDPOINT =
  "https://olivia-ai.o7digital.com/api/olivia/chat";
const OLIVIA_INBOX_ENDPOINT =
  import.meta.env.PUBLIC_OLIVIA_INBOX_ENDPOINT ??
  "https://olivia-ai.o7digital.com/api/widget/conversations";
const htmlLanguage = String(htmlAttributes.lang ?? "").toLowerCase();
const oliviaInitialLanguage = htmlLanguage.startsWith("en")
  ? "en"
  : htmlLanguage.startsWith("zh")
    ? "zh"
    : "es";
---

<html {...htmlAttributes}>
  <head>
    <Fragment set:html={headInnerHtml} />
    {!hasGoogleAnalytics && (
      <>
        <script async src={`https://www.googletagmanager.com/gtag/js?id=${GA_MEASUREMENT_ID}`}></script>
        <script is:inline define:vars={{ GA_MEASUREMENT_ID }}>
          window.dataLayer = window.dataLayer || [];
          function gtag(){dataLayer.push(arguments);}
          gtag('js', new Date());

          gtag('config', GA_MEASUREMENT_ID);
        </script>
      </>
    )}
  </head>
  <body {...bodyAttributes}>
    <Fragment set:html={bodyInnerHtml} />
    <div
      id="olivia-widget"
      class="olivia-widget"
      data-client-code={OLIVIA_CLIENT_CODE}
      data-client-name={OLIVIA_CLIENT_NAME}
      data-language={oliviaInitialLanguage}
      data-chat-endpoint={OLIVIA_CHANNEL_ENDPOINT}
      data-inbox-endpoint={OLIVIA_INBOX_ENDPOINT}
      data-contact-endpoint="https://formspree.io/f/xlggvkgp"
    >
      <button class="olivia-launcher" type="button" aria-label="Abrir Olivia IA Concierge">
        <span class="olivia-launcher__mark">O</span>
        <span class="olivia-launcher__text">Olivia IA Concierge</span>
      </button>

      <section class="olivia-panel" aria-label="Chat Olivia IA Concierge" hidden>
        <header class="olivia-header">
          <div>
            <p class="olivia-kicker">Suites Mine</p>
            <h2>Olivia IA Concierge</h2>
          </div>
          <button class="olivia-close" type="button" aria-label="Cerrar Olivia IA Concierge">×</button>
        </header>

        <div class="olivia-messages" aria-live="polite">
          <div class="olivia-message olivia-message--assistant">
            Hola, soy Olivia AI. Puedo responder sus preguntas y transmitir su solicitud al equipo de Suites Mine. Solo el hotel puede gestionar y confirmar una reserva.
          </div>
          <div class="olivia-actions" data-olivia-actions></div>
        </div>

        <form class="olivia-form">
          <div class="olivia-composer">
            <input
              name="message"
              type="text"
              autocomplete="off"
              placeholder="Escriba su pregunta..."
              required
            />
            <button type="submit">Enviar</button>
          </div>
        </form>
      </section>
    </div>

    <style is:inline>
      .olivia-widget {
        position: fixed;
        right: 22px;
        bottom: 22px;
        z-index: 99999;
        font-family: ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
      }

      .olivia-launcher {
        display: flex;
        align-items: center;
        gap: 10px;
        min-height: 56px;
        border: 0;
        border-radius: 999px;
        padding: 8px 18px 8px 8px;
        background: #1f2a44;
        color: white;
        box-shadow: 0 22px 60px rgba(12, 20, 38, 0.28);
        cursor: pointer;
      }

      .olivia-launcher__mark {
        display: grid;
        place-items: center;
        width: 40px;
        height: 40px;
        border-radius: 50%;
        background: #ffffff;
        color: #1f2a44;
        font-weight: 800;
      }

      .olivia-launcher__text {
        font-size: 15px;
        font-weight: 700;
      }

      .olivia-panel {
        display: flex;
        flex-direction: column;
        width: min(420px, calc(100vw - 28px));
        height: min(680px, calc(100vh - 28px));
        overflow: hidden;
        border: 1px solid rgba(31, 42, 68, 0.14);
        border-radius: 18px;
        background: #ffffff;
        box-shadow: 0 30px 90px rgba(12, 20, 38, 0.28);
      }

      .olivia-panel[hidden] {
        display: none;
      }

      .olivia-widget .olivia-launcher[hidden] {
        display: none;
      }

      .olivia-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 18px;
        background: #1f2a44;
        color: white;
      }

      .olivia-kicker,
      .olivia-header h2 {
        margin: 0;
      }

      .olivia-kicker {
        color: rgba(255, 255, 255, 0.72);
        font-size: 12px;
        font-weight: 700;
        text-transform: uppercase;
      }

      .olivia-header h2 {
        margin-top: 2px;
        font-size: 20px;
        line-height: 1.2;
      }

      .olivia-close {
        display: grid;
        place-items: center;
        width: 36px;
        height: 36px;
        border: 0;
        border-radius: 50%;
        background: rgba(255, 255, 255, 0.12);
        color: white;
        cursor: pointer;
        font-size: 24px;
        line-height: 1;
      }

      .olivia-messages {
        display: flex;
        flex-direction: column;
        gap: 10px;
        flex: 1;
        min-height: 0;
        overflow-y: auto;
        padding: 16px;
        background: #f6f4ee;
      }

      .olivia-message {
        max-width: 86%;
        border-radius: 14px;
        padding: 11px 13px;
        font-size: 14px;
        line-height: 1.45;
        white-space: pre-line;
      }

      .olivia-message--assistant {
        align-self: flex-start;
        background: white;
        color: #222833;
        border: 1px solid rgba(31, 42, 68, 0.1);
      }

      .olivia-message--user {
        align-self: flex-end;
        background: #1f2a44;
        color: white;
      }

      .olivia-message a {
        color: inherit;
        font-weight: 700;
        overflow-wrap: anywhere;
        text-decoration: underline;
      }

      .olivia-whatsapp-button {
        display: block;
        margin-top: 12px;
        padding: 10px 14px;
        border-radius: 10px;
        background: #25d366;
        color: white !important;
        text-align: center;
        text-decoration: none !important;
      }

      .olivia-actions {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 8px;
        width: 100%;
      }

      .olivia-action {
        min-height: 40px;
        border: 1px solid rgba(95, 79, 45, 0.75);
        border-radius: 10px;
        background: transparent;
        color: #1f2a44;
        cursor: pointer;
        font-size: 12px;
        font-weight: 800;
        letter-spacing: 0.06em;
        text-transform: uppercase;
      }

      .olivia-action:hover {
        background: rgba(200, 170, 112, 0.18);
      }

      .olivia-message--typing {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        width: fit-content;
        min-width: 56px;
      }

      .olivia-message--typing span {
        width: 6px;
        height: 6px;
        border-radius: 50%;
        background: #6f7685;
        animation: oliviaTyping 1s infinite ease-in-out;
      }

      .olivia-message--typing span:nth-child(2) {
        animation-delay: 0.15s;
      }

      .olivia-message--typing span:nth-child(3) {
        animation-delay: 0.3s;
      }

      @keyframes oliviaTyping {
        0%,
        80%,
        100% {
          opacity: 0.35;
          transform: translateY(0);
        }

        40% {
          opacity: 1;
          transform: translateY(-3px);
        }
      }

      .olivia-form {
        flex-shrink: 0;
        border-top: 1px solid rgba(31, 42, 68, 0.12);
        background: white;
        padding: 12px;
      }

      .olivia-request-form {
        display: grid;
        gap: 10px;
        padding: 14px;
        border: 1px solid #c9c5bd;
        border-radius: 14px;
        color: #1f2a44;
        background: #fff;
      }
      .olivia-request-form label { display: grid; gap: 4px; font-size: 13px; }
      .olivia-request-form input, .olivia-request-form textarea, .olivia-composer input {
        min-width: 0;
        width: 100%;
        box-sizing: border-box;
        border: 1px solid #aaa;
        border-radius: 8px;
        padding: 8px;
        background: white;
        color: #1f2a44;
      }
      .olivia-request-form textarea { min-height: 100px; resize: vertical; }
      .olivia-request-form p { margin: 0; font-size: 12px; }
      .olivia-request-form button {
        min-height: 44px;
        padding: 8px;
        border: 0;
        border-radius: 8px;
        background: #1f2a44;
        color: white;
        cursor: pointer;
      }
      .olivia-request-form button:disabled { opacity: 0.6; cursor: wait; }

      .olivia-composer {
        display: flex;
        gap: 8px;
      }

      .olivia-composer input {
        flex: 1;
        height: 44px;
        padding: 0 12px;
        font-size: 14px;
      }

      .olivia-composer button {
        border: 0;
        border-radius: 10px;
        padding: 0 14px;
        background: #b88a44;
        color: white;
        cursor: pointer;
        font-size: 13px;
        font-weight: 800;
      }

      @media (max-width: 540px) {
        .olivia-widget {
          right: 14px;
          bottom: 14px;
        }

        .olivia-panel {
        display: flex;
        flex-direction: column;
          height: min(640px, calc(100vh - 28px));
        }

        .olivia-messages {
          flex: 1;
          min-height: 0;
        }
      }
    </style>

    <script is:inline src="/olivia-concierge.js" defer></script>
    <script is:inline src="https://olivia-ai.o7digital.com/olivia-floating-theme.js" defer></script>
  </body>
</html>
