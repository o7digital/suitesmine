              words: ["amenities", "rooftop", "terrace", "jacuzzi", "bar", "gym", "food"],
              answer:
                "Suites Mine has a rooftop open daily from 10:30 am to 10:00 pm, a common jacuzzi for 8 people, small lounge, sunbeds, tables, bar, bathrooms with shower and a la carte food service. A gym is planned for the branch.",
            },
            {
              words: ["discount", "long stay", "week", "month", "monthly"],
              answer:
                "There is a nightly rate, a 10% weekly discount from 7 consecutive nights in the same room, and a 20% monthly discount from 30 consecutive nights. These discounts are available on the official website and by phone.",
            },
            {
              words: ["payment", "card", "cash", "transfer", "visa", "mastercard", "amex"],
              answer:
                "Suites Mine accepts cash in Mexican pesos and Visa, MasterCard, Carnet and American Express credit/debit cards. For advance phone reservations, national bank transfer or virtual payment link may be requested.",
            },
            {
              words: ["invoice", "billing", "vat", "tax"],
              answer:
                "Most reservations can be invoiced with itemized VAT. A Mexican SAT Tax Status Certificate and email are required during the stay. Foreign guests can request a non-SAT-certified receipt.",
            },
          ],
        }[language];

        const launcher = widget.querySelector(".olivia-launcher");
        const panel = widget.querySelector(".olivia-panel");
        const closeButton = widget.querySelector(".olivia-close");
        const form = widget.querySelector(".olivia-form");
        const messages = widget.querySelector(".olivia-messages");
        const firstMessage = widget.querySelector(".olivia-message--assistant");
        const messageInput = widget.querySelector('input[name="message"]');
        const submitButton = widget.querySelector('.olivia-composer button[type="submit"]');
        const bookingDraft = {
          active: false,
          name: "",
          email: "",
          phone: "",
          checkIn: "",
          checkOut: "",
          guests: "",
          roomType: "",
        };

        launcher?.setAttribute("aria-label", copy.launcherLabel);
        panel?.setAttribute("aria-label", copy.panelLabel);
        closeButton?.setAttribute("aria-label", copy.closeLabel);
        const launcherText = widget.querySelector(".olivia-launcher__text");
        const headerTitle = widget.querySelector(".olivia-header h2");
        if (launcherText) launcherText.textContent = copy.displayName;
        if (headerTitle) headerTitle.textContent = copy.displayName;
        widget.querySelector('[data-olivia-i18n="checkIn"]').textContent = copy.checkIn;
        widget.querySelector('[data-olivia-i18n="checkOut"]').textContent = copy.checkOut;
        widget.querySelector('[data-olivia-i18n="guests"]').textContent = copy.guests;
        if (firstMessage) firstMessage.textContent = copy.welcome;
        if (messageInput) messageInput.placeholder = copy.placeholder;
        if (submitButton) submitButton.textContent = copy.send;
        setupDateLimits();

        function addOliviaMessage(content, role) {
          const message = document.createElement("div");
          message.className = `olivia-message olivia-message--${role}`;
          message.textContent = content;
          messages?.appendChild(message);
          messages?.scrollTo({ top: messages.scrollHeight, behavior: "smooth" });
        }

        function addTypingMessage() {
          const message = document.createElement("div");
          message.className = "olivia-message olivia-message--assistant olivia-message--typing";
          message.setAttribute("aria-label", language === "en" ? "Olivia is typing" : "Olivia esta escribiendo");
          message.innerHTML = "<span></span><span></span><span></span>";
          messages?.appendChild(message);
          messages?.scrollTo({ top: messages.scrollHeight, behavior: "smooth" });
          return message;
        }

        function addAssistantMessageWithTyping(content) {
          const typing = addTypingMessage();
          window.setTimeout(() => {
            typing.remove();
            addOliviaMessage(content, "assistant");
          }, Math.min(1200, Math.max(450, content.length * 8)));
        }

        function normalizeText(value) {
          return value
            .toLowerCase()
            .normalize("NFD")
            .replace(/[\u0300-\u036f]/g, "");
        }

        function hasAny(text, words) {
          return words.some((word) => text.includes(word));
        }

        function isBookingIntent(normalized) {
          return hasAny(normalized, [
            "quiero reservar",
            "podemos reservar",
            "me haces la reserva",
            "hacer la reserva",
            "hacer reserva",
            "reservar ahora",
            "confirmar reserva",
            "book now",
            "make a booking",
            "make reservation",
            "i want to book",
            "i would like to book",
          ]);
        }

        function pickRoomType(text) {
          const normalized = normalizeText(text);
          if (/^\s*1\s*$/.test(normalized)) return language === "en" ? "Studio" : "Estudio";
          if (/^\s*2\s*$/.test(normalized)) return "Suite";
          if (/^\s*3\s*$/.test(normalized)) return language === "en" ? "Double Suite" : "Suite Doble";
          if (hasAny(normalized, ["suite doble", "double suite", "doble"])) return language === "en" ? "Double Suite" : "Suite Doble";
          if (hasAny(normalized, ["suite"])) return "Suite";
          if (hasAny(normalized, ["estudio", "studio"])) return language === "en" ? "Studio" : "Estudio";
          return "";
        }

        function formatDateInput(date) {
          const year = date.getFullYear();
          const month = String(date.getMonth() + 1).padStart(2, "0");
          const day = String(date.getDate()).padStart(2, "0");
          return `${year}-${month}-${day}`;
        }

        function addDays(date, days) {
          const next = new Date(date);
          next.setDate(next.getDate() + days);
          return next;
        }

        function setupDateLimits() {
          const checkInInput = form?.querySelector('input[name="checkIn"]');
          const checkOutInput = form?.querySelector('input[name="checkOut"]');
          if (!checkInInput || !checkOutInput) return;

          const minimumCheckIn = formatDateInput(addDays(new Date(), 2));
          checkInInput.min = minimumCheckIn;
          if (!checkInInput.value || checkInInput.value < minimumCheckIn) {
            checkInInput.value = minimumCheckIn;
          }

          function updateCheckOutMinimum() {
            const base = checkInInput.value ? new Date(`${checkInInput.value}T00:00:00`) : addDays(new Date(), 2);
            const minimumCheckOut = formatDateInput(addDays(base, 1));
            checkOutInput.min = minimumCheckOut;
            if (!checkOutInput.value || checkOutInput.value < minimumCheckOut) {
              checkOutInput.value = minimumCheckOut;
            }
          }

          updateCheckOutMinimum();
          checkInInput.addEventListener("change", updateCheckOutMinimum);
        }

        function valueAfterStep(text, step) {
          const match = text.match(new RegExp(`(?:^|\\s)${step}[.)]?\\s*([\\s\\S]*?)(?=\\s\\d[.)]?\\s|$)`, "i"));
          return match?.[1]?.trim().replace(/^[:.-]\s*/, "") || "";
        }

        function parseStructuredBooking(text) {
          const normalized = normalizeText(text);
          const name = valueAfterStep(text, 1);
          const email = text.match(/[^\s@]+@[^\s@]+\.[^\s@]+/)?.[0] || valueAfterStep(text, 2);
          const phone = valueAfterStep(text, 3).match(/(?:\+?\d[\d\s().-]{6,}\d)/)?.[0] || "";
          const guests = valueAfterStep(text, 4).match(/\b\d+\b/)?.[0] || "";
          const room = pickRoomType(valueAfterStep(text, 5) || text);

          if (name && !name.includes("@")) bookingDraft.name = name;
          if (email) bookingDraft.email = email;
          if (phone) bookingDraft.phone = phone;
          if (guests && !bookingDraft.guests) bookingDraft.guests = guests;
          if (room) bookingDraft.roomType = room;

          if (hasAny(normalized, ["mis fechas", "fechas aqui", "dates below", "date fields"])) {
            return;
          }
        }

        function fillBookingDraft(text, metadata, captureName = true) {
          const trimmed = text.trim();
          const email = trimmed.match(/[^\s@]+@[^\s@]+\.[^\s@]+/)?.[0] || "";
          const phone = trimmed.match(/(?:\+?\d[\d\s().-]{6,}\d)/)?.[0] || "";
          const roomType = pickRoomType(trimmed);

          parseStructuredBooking(trimmed);
          if (metadata.checkIn) bookingDraft.checkIn = String(metadata.checkIn);
          if (metadata.checkOut) bookingDraft.checkOut = String(metadata.checkOut);
          if (metadata.guests) bookingDraft.guests = String(metadata.guests);
          if (email) bookingDraft.email = email;
          if (phone) bookingDraft.phone = phone;
          if (roomType) bookingDraft.roomType = roomType;

          if (captureName && bookingDraft.active && !bookingDraft.name && !email && !phone && !roomType && trimmed.length > 3 && !/\b\d[.)]?\s/.test(trimmed)) {
            bookingDraft.name = trimmed;
          } else if (bookingDraft.active && bookingDraft.name && !bookingDraft.email && email) {
            bookingDraft.email = email;
          } else if (bookingDraft.active && bookingDraft.email && !bookingDraft.phone && phone) {
            bookingDraft.phone = phone;
          }
        }

        function nextBookingAnswer() {
          if (!bookingDraft.name) return copy.askName;
          if (!bookingDraft.email) return copy.askEmail;
          if (!bookingDraft.phone) return copy.askPhone;
          if (!bookingDraft.checkIn || !bookingDraft.checkOut) return copy.askDates;
          if (!bookingDraft.guests) return copy.askGuests;
          if (!bookingDraft.roomType) return copy.askRoom;

          return copy.bookingReady
            .replace("{name}", bookingDraft.name)
            .replace("{email}", bookingDraft.email)
            .replace("{phone}", bookingDraft.phone)
            .replace("{checkIn}", bookingDraft.checkIn)
            .replace("{checkOut}", bookingDraft.checkOut)
            .replace("{guests}", bookingDraft.guests)
            .replace("{roomType}", bookingDraft.roomType)
            .concat(`\n\n${copy.paymentNext}`);
        }

        function answerFromSiteKnowledge(text, metadata) {
          const normalized = normalizeText(text);
          const hasDates = Boolean(metadata.checkIn && metadata.checkOut);
          const selectedRoomType = pickRoomType(text);

          if (isBookingIntent(normalized)) {
            bookingDraft.active = true;
            fillBookingDraft(text, metadata, false);
            return nextBookingAnswer();
          }

          if (selectedRoomType && hasDates) {
            bookingDraft.active = true;
            fillBookingDraft(text, metadata, false);
            return nextBookingAnswer();
          }

          if (bookingDraft.active) {
            fillBookingDraft(text, metadata);
            return nextBookingAnswer();
          }

          if (hasAny(normalized, ["humano", "persona", "agente", "asesor", "equipo", "manual", "take over", "human", "agent"])) {
            return copy.human;
          }

          if (hasAny(normalized, ["dispo", "available", "availability", "tarifa", "precio", "rate", "price", "habitacion", "room"])) {
            if (hasAny(normalized, ["habitacion", "room", "suite", "estudio", "studio"]) && !hasAny(normalized, ["dispo", "available", "availability", "tarifa", "precio", "rate", "price", "reserva", "booking", "book"])) {
              return copy.rooms;
            }
            if (!hasDates && hasAny(normalized, ["dispo", "available", "availability", "tarifa", "precio", "rate", "price"])) {
              return copy.needDates;
            }
            return `${copy.availability}\n\n${language === "en" ? "Booking link:" : "Link de reserva:"} ${hotelKnowledge.bookingUrl}`;
          }

          if (hasAny(normalized, ["reserva", "reservar", "booking", "book"])) {
            return copy.booking;
          }

          const faqAnswer = faqAnswers.find((item) => hasAny(normalized, item.words));
          if (faqAnswer) return faqAnswer.answer;

          if (hasAny(normalized, ["ubicacion", "direccion", "donde", "location", "address", "where", "angel", "cuauhtemoc"])) {
            return copy.location;
          }

          if (hasAny(normalized, ["servicio", "amenidad", "wifi", "terraza", "jacuzzi", "restaurant", "bar", "service", "amenity"])) {
            return copy.services;
          }

          if (hasAny(normalized, ["contacto", "telefono", "email", "correo", "phone", "mail", "contact"])) {
            return copy.contact;
          }

          if (hasAny(normalized, ["hola", "hello", "hi", "buenos", "buenas"])) {
            return copy.welcome;
          }

          return copy.fallback;
        }

        launcher?.addEventListener("click", () => {
          panel.hidden = false;
          launcher.hidden = true;
        });

        closeButton?.addEventListener("click", () => {
          panel.hidden = true;
          launcher.hidden = false;
        });

        form?.addEventListener("submit", async (event) => {
          event.preventDefault();
          const formData = new FormData(form);
          const text = String(formData.get("message") || "").trim();
          if (!text) return;

          addOliviaMessage(text, "user");
          if (messageInput) messageInput.value = "";

          const payload = {
            clientCode: OLIVIA_CLIENT_CODE,
            clientName: OLIVIA_CLIENT_NAME,
            source: "website",
            language,
            pageUrl: window.location.href,
            message: text,
            metadata: {
              checkIn: formData.get("checkIn") || "",
              checkOut: formData.get("checkOut") || "",
              guests: formData.get("guests") || "",
            },
            createdAt: new Date().toISOString(),
          };
          let answer = answerFromSiteKnowledge(text, payload.metadata);
          payload.metadata.bookingDraft = { ...bookingDraft };

          try {
            if (OLIVIA_CHANNEL_ENDPOINT) {
              const response = await fetch(OLIVIA_CHANNEL_ENDPOINT, {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify(payload),
              });
              const apiAnswer = await response.json().catch(() => null);
              if (response.ok && apiAnswer?.reply) {
                answer = apiAnswer.reply;
              }
            }
            addAssistantMessageWithTyping(answer);
          } catch {
            addAssistantMessageWithTyping(answer);
          }
        });
      })();
    </script>
  </body>
</html>
