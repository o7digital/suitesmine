---
type Props = {
  htmlAttributes?: Record<string, string | boolean>;
  headInnerHtml: string;
  bodyAttributes?: Record<string, string | boolean>;
  bodyInnerHtml: string;
};

const {
  htmlAttributes = {},
  headInnerHtml,
  bodyAttributes = {},
  bodyInnerHtml,
} = Astro.props as Props;

const GA_MEASUREMENT_ID = "G-F2QTNE0PJ1";
const hasGoogleAnalytics = headInnerHtml.includes(GA_MEASUREMENT_ID);
const OLIVIA_CLIENT_CODE = "suitesmine";
const OLIVIA_CLIENT_NAME = "Suites Mine";
const OLIVIA_CHANNEL_ENDPOINT =
  "https://suitesmine-bot-git-dev-olivier-steineur.vercel.app/api/olivia/chat";
const OLIVIA_INBOX_ENDPOINT =
  import.meta.env.PUBLIC_OLIVIA_INBOX_ENDPOINT ??
  "https://suitesmine-bot-git-dev-olivier-steineur.vercel.app/api/widget/conversations";
const htmlLanguage = String(htmlAttributes.lang ?? "").toLowerCase();
const oliviaInitialLanguage = htmlLanguage.startsWith("en")
  ? "en"
  : htmlLanguage.startsWith("zh")
    ? "zh"
    : "es";
---

<html {...htmlAttributes}>
  <head>
    <Fragment set:html={headInnerHtml} />
    {!hasGoogleAnalytics && (
      <>
        <script async src={`https://www.googletagmanager.com/gtag/js?id=${GA_MEASUREMENT_ID}`}></script>
        <script is:inline define:vars={{ GA_MEASUREMENT_ID }}>
          window.dataLayer = window.dataLayer || [];
          function gtag(){dataLayer.push(arguments);}
          gtag('js', new Date());

          gtag('config', GA_MEASUREMENT_ID);
        </script>
      </>
    )}
  </head>
  <body {...bodyAttributes}>
    <Fragment set:html={bodyInnerHtml} />
    {true && (
      <>
    <div
      id="olivia-widget"
      class="olivia-widget"
      data-client-code={OLIVIA_CLIENT_CODE}
      data-client-name={OLIVIA_CLIENT_NAME}
      data-language={oliviaInitialLanguage}
    >
      <button class="olivia-launcher" type="button" aria-label="Abrir Olivia IA Concierge">
        <span class="olivia-launcher__mark">O</span>
        <span class="olivia-launcher__text">Olivia IA Concierge</span>
      </button>

      <section class="olivia-panel" aria-label="Chat Olivia IA Concierge" hidden>
        <header class="olivia-header">
          <div>
            <p class="olivia-kicker">Suites Mine</p>
            <h2>Olivia IA Concierge</h2>
          </div>
          <button class="olivia-close" type="button" aria-label="Cerrar Olivia IA Concierge">×</button>
        </header>

        <div class="olivia-messages" aria-live="polite">
          <div class="olivia-message olivia-message--assistant">
            Hola, soy Olivia IA Concierge. Puedo ayudarle con disponibilidad, tarifas y solicitudes de reserva.
          </div>
          <div class="olivia-actions" data-olivia-actions></div>
        </div>

        <form class="olivia-form">
          <div class="olivia-fields">
            <label>
              <span data-olivia-i18n="checkIn">Llegada</span>
              <input name="checkIn" type="date" />
            </label>
            <label>
              <span data-olivia-i18n="checkOut">Salida</span>
              <input name="checkOut" type="date" />
            </label>
            <label>
              <span data-olivia-i18n="guests">Huespedes</span>
              <input name="guests" type="number" min="1" placeholder="2" />
            </label>
          </div>
          <div class="olivia-composer">
            <input
              name="message"
              type="text"
              autocomplete="off"
              placeholder="Escriba su pregunta..."
              required
            />
            <button type="submit">Enviar</button>
          </div>
        </form>
      </section>
    </div>

    <style is:inline>
      .olivia-widget {
        position: fixed;
        right: 22px;
        bottom: 22px;
        z-index: 99999;
        font-family: ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
      }

      .olivia-launcher {
        display: flex;
        align-items: center;
        gap: 10px;
        min-height: 56px;
        border: 0;
        border-radius: 999px;
        padding: 8px 18px 8px 8px;
        background: #1f2a44;
        color: white;
        box-shadow: 0 22px 60px rgba(12, 20, 38, 0.28);
        cursor: pointer;
      }

      .olivia-launcher__mark {
        display: grid;
        place-items: center;
        width: 40px;
        height: 40px;
        border-radius: 50%;
        background: #ffffff;
        color: #1f2a44;
        font-weight: 800;
      }

      .olivia-launcher__text {
        font-size: 15px;
        font-weight: 700;
      }

      .olivia-panel {
        width: min(420px, calc(100vw - 28px));
        height: min(680px, calc(100vh - 28px));
        overflow: hidden;
        border: 1px solid rgba(31, 42, 68, 0.14);
        border-radius: 18px;
        background: #ffffff;
        box-shadow: 0 30px 90px rgba(12, 20, 38, 0.28);
      }

      .olivia-panel[hidden] {
        display: none;
      }

      .olivia-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 18px;
        background: #1f2a44;
        color: white;
      }

      .olivia-kicker,
      .olivia-header h2 {
        margin: 0;
      }

      .olivia-kicker {
        color: rgba(255, 255, 255, 0.72);
        font-size: 12px;
        font-weight: 700;
        text-transform: uppercase;
      }

      .olivia-header h2 {
        margin-top: 2px;
        font-size: 20px;
        line-height: 1.2;
      }

      .olivia-close {
        display: grid;
        place-items: center;
        width: 36px;
        height: 36px;
        border: 0;
        border-radius: 50%;
        background: rgba(255, 255, 255, 0.12);
        color: white;
        cursor: pointer;
        font-size: 24px;
        line-height: 1;
      }

      .olivia-messages {
        display: flex;
        flex-direction: column;
        gap: 10px;
        height: calc(100% - 236px);
        overflow-y: auto;
        padding: 16px;
        background: #f6f4ee;
      }

      .olivia-message {
        max-width: 86%;
        border-radius: 14px;
        padding: 11px 13px;
        font-size: 14px;
        line-height: 1.45;
        white-space: pre-line;
      }

      .olivia-message--assistant {
        align-self: flex-start;
        background: white;
        color: #222833;
        border: 1px solid rgba(31, 42, 68, 0.1);
      }

      .olivia-message--user {
        align-self: flex-end;
        background: #1f2a44;
        color: white;
      }

      .olivia-message a {
        color: inherit;
        font-weight: 700;
        overflow-wrap: anywhere;
        text-decoration: underline;
      }

      .olivia-whatsapp-button {
        display: block;
        margin-top: 12px;
        padding: 10px 14px;
        border-radius: 10px;
        background: #25d366;
        color: white !important;
        text-align: center;
        text-decoration: none !important;
      }

      .olivia-actions {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 8px;
        width: 100%;
      }

      .olivia-action {
        min-height: 40px;
        border: 1px solid rgba(95, 79, 45, 0.75);
        border-radius: 10px;
        background: transparent;
        color: #1f2a44;
        cursor: pointer;
        font-size: 12px;
        font-weight: 800;
        letter-spacing: 0.06em;
        text-transform: uppercase;
      }

      .olivia-action:hover {
        background: rgba(200, 170, 112, 0.18);
      }

      .olivia-message--typing {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        width: fit-content;
        min-width: 56px;
      }

      .olivia-message--typing span {
        width: 6px;
        height: 6px;
        border-radius: 50%;
        background: #6f7685;
        animation: oliviaTyping 1s infinite ease-in-out;
      }

      .olivia-message--typing span:nth-child(2) {
        animation-delay: 0.15s;
      }

      .olivia-message--typing span:nth-child(3) {
        animation-delay: 0.3s;
      }

      @keyframes oliviaTyping {
        0%,
        80%,
        100% {
          opacity: 0.35;
          transform: translateY(0);
        }

        40% {
          opacity: 1;
          transform: translateY(-3px);
        }
      }

      .olivia-form {
        border-top: 1px solid rgba(31, 42, 68, 0.12);
        background: white;
        padding: 12px;
      }

      .olivia-fields {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 8px;
        margin-bottom: 10px;
      }

      .olivia-fields label {
        display: flex;
        min-width: 0;
        flex-direction: column;
        gap: 4px;
        color: #5f6675;
        font-size: 11px;
        font-weight: 700;
      }

      .olivia-fields input,
      .olivia-composer input {
        min-width: 0;
        border: 1px solid rgba(31, 42, 68, 0.18);
        border-radius: 10px;
        background: #fbfbfd;
        color: #1f2a44;
        outline: 0;
      }

      .olivia-fields input {
        height: 36px;
        padding: 0 8px;
        font-size: 12px;
      }

      .olivia-composer {
        display: flex;
        gap: 8px;
      }

      .olivia-composer input {
        flex: 1;
        height: 44px;
        padding: 0 12px;
        font-size: 14px;
      }

      .olivia-composer button {
        border: 0;
        border-radius: 10px;
        padding: 0 14px;
        background: #b88a44;
        color: white;
        cursor: pointer;
        font-size: 13px;
        font-weight: 800;
      }

      @media (max-width: 540px) {
        .olivia-widget {
          right: 14px;
          bottom: 14px;
        }

        .olivia-panel {
          height: min(640px, calc(100vh - 28px));
        }

        .olivia-fields {
          grid-template-columns: 1fr;
        }

        .olivia-messages {
          height: calc(100% - 330px);
        }
      }
    </style>

    <script is:inline define:vars={{ OLIVIA_CLIENT_CODE, OLIVIA_CLIENT_NAME, OLIVIA_CHANNEL_ENDPOINT, OLIVIA_INBOX_ENDPOINT }}>
      (() => {
        const widget = document.getElementById("olivia-widget");
        if (!widget || widget.dataset.ready === "true") return;
        widget.dataset.ready = "true";

        const language = window.location.pathname.startsWith("/en")
          ? "en"
          : window.location.pathname.startsWith("/zh")
            ? "zh"
            : "es";
        const copy = {
          es: {
            displayName: "Olivia IA Concierge",
            launcherLabel: "Abrir Olivia IA Concierge",
            panelLabel: "Chat Olivia IA Concierge",
            closeLabel: "Cerrar Olivia IA Concierge",
            checkIn: "Llegada",
            checkOut: "Salida",
            guests: "Huespedes",
            placeholder: "Escriba su pregunta...",
            send: "Enviar",
            actions: [
              ["Reserva", "Deseo reservar"],
              ["Disponibilidad", "Quiero revisar disponibilidad"],
              ["Suites", "Quiero ver suites"],
              ["Agente", "Quiero hablar con un agente"],
            ],
            welcome:
              "Hola, soy Olivia IA Concierge. Conozco Suites Mine y puedo responder sobre habitaciones, ubicación, servicios, tarifas y disponibilidad.",
            apiError:
              "Olivia no pudo responder en este momento. Intente de nuevo en unos segundos o contacte a Suites Mine directamente.",
          },
          en: {
            displayName: "Olivia AI Concierge",
            launcherLabel: "Open Olivia AI Concierge",
            panelLabel: "Olivia AI Concierge chat",
            closeLabel: "Close Olivia AI Concierge",
            checkIn: "Check in",
            checkOut: "Check out",
            guests: "Guests",
            placeholder: "Ask your question...",
            send: "Send",
            actions: [
              ["Reservation", "I want to book"],
              ["Availability", "I want to check availability"],
              ["Suites", "I want to see suites"],
              ["Agent", "I want to speak with an agent"],
            ],
            welcome:
              "Hello, I am Olivia AI Concierge. I know Suites Mine and can answer questions about rooms, location, services, rates and availability.",
            apiError:
              "Olivia could not answer right now. Please try again in a few seconds or contact Suites Mine directly.",
          },
          zh: {
            displayName: "Olivia AI 礼宾",
            launcherLabel: "打开 Olivia AI 礼宾",
            panelLabel: "Olivia AI 礼宾聊天",
            closeLabel: "关闭 Olivia AI 礼宾",
            checkIn: "入住",
            checkOut: "退房",
            guests: "客人",
            placeholder: "询问日期、价格或预订...",
            send: "发送",
            actions: [
              ["预订", "我想预订"],
              ["查房态", "我想查询可订日期"],
              ["套房", "我想查看套房"],
              ["客服", "我想联系人工客服"],
            ],
            welcome:
              "您好，我是 Olivia AI 礼宾。我了解 Suites Mine，可以回答有关房型、位置、服务、价格和可订情况的问题。",
            apiError:
              "Olivia 现在无法回复。请稍后再试，或直接联系 Suites Mine。",
          },
        }[language];

        const launcher = widget.querySelector(".olivia-launcher");
        const panel = widget.querySelector(".olivia-panel");
        const closeButton = widget.querySelector(".olivia-close");
        const form = widget.querySelector(".olivia-form");
        const messages = widget.querySelector(".olivia-messages");
        const actions = widget.querySelector("[data-olivia-actions]");
        const firstMessage = widget.querySelector(".olivia-message--assistant");
        const messageInput = widget.querySelector('input[name="message"]');
        const submitButton = widget.querySelector('.olivia-composer button[type="submit"]');
        const bookingDraft = {};
        const visitorId =
          window.localStorage.getItem("oliviaVisitorId") || window.crypto.randomUUID();
        const receivedOperatorMessages = new Set();
        window.localStorage.setItem("oliviaVisitorId", visitorId);

        launcher?.setAttribute("aria-label", copy.launcherLabel);
        panel?.setAttribute("aria-label", copy.panelLabel);
        closeButton?.setAttribute("aria-label", copy.closeLabel);
        const launcherText = widget.querySelector(".olivia-launcher__text");
        const headerTitle = widget.querySelector(".olivia-header h2");
        if (launcherText) launcherText.textContent = copy.displayName;
        if (headerTitle) headerTitle.textContent = copy.displayName;
        widget.querySelector('[data-olivia-i18n="checkIn"]').textContent = copy.checkIn;
        widget.querySelector('[data-olivia-i18n="checkOut"]').textContent = copy.checkOut;
        widget.querySelector('[data-olivia-i18n="guests"]').textContent = copy.guests;
        if (firstMessage) firstMessage.textContent = copy.welcome;
        if (messageInput) messageInput.placeholder = copy.placeholder;
        if (submitButton) submitButton.textContent = copy.send;
        if (actions) {
          actions.innerHTML = "";
          copy.actions.forEach(([label, prompt]) => {
            const button = document.createElement("button");
            button.type = "button";
            button.className = "olivia-action";
            button.textContent = label;
            button.addEventListener("click", () => submitOliviaMessage(prompt));
            actions.appendChild(button);
          });
        }
        setupDateLimits();

        function addOliviaMessage(content, role, options = {}) {
          const message = document.createElement("div");
          message.className = `olivia-message olivia-message--${role}`;
          if (role === "assistant") {
            const parts = content.split(/(https?:\/\/[^\s]+)/g).filter(Boolean);
            parts.forEach((part) => {
              if (part.startsWith("http")) {
                const link = document.createElement("a");
                link.href = part;
                link.target = "_blank";
                link.rel = "noopener noreferrer";
                link.textContent = part;
                message.appendChild(link);
              } else {
                message.appendChild(document.createTextNode(part));
              }
            });
            if (options.whatsapp) {
              const whatsapp = document.createElement("a");
              whatsapp.className = "olivia-whatsapp-button";
              whatsapp.href = "https://wa.me/525536668535";
              whatsapp.target = "_blank";
              whatsapp.rel = "noopener noreferrer";
              whatsapp.textContent =
                language === "en"
                  ? "Contact hotel on WhatsApp"
                  : language === "zh"
                    ? "通过 WhatsApp 联系酒店"
                    : "Contactar al hotel por WhatsApp";
              message.appendChild(whatsapp);
            }
          } else {
            message.textContent = content;
          }
          messages?.appendChild(message);
          messages?.scrollTo({ top: messages.scrollHeight, behavior: "smooth" });
        }

        function addTypingMessage() {
          const message = document.createElement("div");
          message.className = "olivia-message olivia-message--assistant olivia-message--typing";
          message.setAttribute("aria-label", language === "en" ? "Olivia is typing" : "Olivia esta escribiendo");
          message.innerHTML = "<span></span><span></span><span></span>";
          messages?.appendChild(message);
          messages?.scrollTo({ top: messages.scrollHeight, behavior: "smooth" });
          return message;
        }

        function addAssistantMessageWithTyping(content, options = {}) {
          const typing = addTypingMessage();
          window.setTimeout(() => {
            typing.remove();
            addOliviaMessage(content, "assistant", options);
          }, Math.min(1200, Math.max(450, content.length * 8)));
        }

        function getAssistantText(response) {
          if (!response) return "";
          if (typeof response === "string") return response;
          return response.reply || response.response || response.message || response.output || "";
        }

        async function persistInboxMessage(content) {
          if (!OLIVIA_INBOX_ENDPOINT) return;
          const response = await fetch(OLIVIA_INBOX_ENDPOINT, {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({
              clientCode: OLIVIA_CLIENT_CODE,
              visitorId,
              content,
              source: "website",
              language,
              metadata: { page: window.location.pathname },
            }),
          });
          return response.ok ? response.json() : null;
        }

        async function persistInboxAssistant(content) {
          if (!OLIVIA_INBOX_ENDPOINT) return;
          await fetch(OLIVIA_INBOX_ENDPOINT, {
            method: "PATCH",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ clientCode: OLIVIA_CLIENT_CODE, visitorId, content }),
          });
        }

        async function pollOperatorMessages() {
          if (!OLIVIA_INBOX_ENDPOINT) return;
          try {
            const params = new URLSearchParams({ clientCode: OLIVIA_CLIENT_CODE, visitorId });
            const response = await fetch(`${OLIVIA_INBOX_ENDPOINT}?${params}`);
            if (!response.ok) return;
            const data = await response.json();
            (data.messages || [])
              .filter((message) => message.role === "operator" && !receivedOperatorMessages.has(message.id))
              .forEach((message) => {
                receivedOperatorMessages.add(message.id);
                addAssistantMessageWithTyping(message.content);
              });
          } catch {}
        }
        window.setInterval(pollOperatorMessages, 4000);

        function formatDateInput(date) {
          const year = date.getFullYear();
          const month = String(date.getMonth() + 1).padStart(2, "0");
          const day = String(date.getDate()).padStart(2, "0");
          return `${year}-${month}-${day}`;
        }

        function addDays(date, days) {
          const next = new Date(date);
          next.setDate(next.getDate() + days);
          return next;
        }

        function setupDateLimits() {
          const checkInInput = form?.querySelector('input[name="checkIn"]');
          const checkOutInput = form?.querySelector('input[name="checkOut"]');
          if (!checkInInput || !checkOutInput) return;

          const minimumCheckIn = formatDateInput(addDays(new Date(), 2));
          checkInInput.min = minimumCheckIn;
          if (!checkInInput.value || checkInInput.value < minimumCheckIn) {
            checkInInput.value = minimumCheckIn;
          }

          function updateCheckOutMinimum() {
            const base = checkInInput.value ? new Date(`${checkInInput.value}T00:00:00`) : addDays(new Date(), 2);
            const minimumCheckOut = formatDateInput(addDays(base, 1));
            checkOutInput.min = minimumCheckOut;
            if (!checkOutInput.value || checkOutInput.value < minimumCheckOut) {
              checkOutInput.value = minimumCheckOut;
            }
          }

          updateCheckOutMinimum();
          checkInInput.addEventListener("change", updateCheckOutMinimum);
        }

        launcher?.addEventListener("click", () => {
          panel.hidden = false;
          launcher.hidden = true;
        });

        closeButton?.addEventListener("click", () => {
          panel.hidden = true;
          launcher.hidden = false;
        });

        async function submitOliviaMessage(overrideText = "") {
          const formData = new FormData(form);
          const text = String(overrideText || formData.get("message") || "").trim();
          if (!text) return;

          addOliviaMessage(text, "user");
          if (messageInput) messageInput.value = "";
          if (submitButton) submitButton.disabled = true;

          const payload = {
            clientCode: OLIVIA_CLIENT_CODE,
            clientId: OLIVIA_CLIENT_CODE,
            clientName: OLIVIA_CLIENT_NAME,
            visitorId,
            source: "website",
            language,
            pageUrl: window.location.href,
            message: text,
            metadata: {
              checkIn: formData.get("checkIn") || "",
              checkOut: formData.get("checkOut") || "",
              guests: formData.get("guests") || "",
            },
            createdAt: new Date().toISOString(),
          };
          payload.metadata.bookingDraft = { ...bookingDraft };

          try {
            await persistInboxMessage(text).catch(() => null);

            if (!OLIVIA_CHANNEL_ENDPOINT) throw new Error("Missing Olivia endpoint");

            const response = await fetch(OLIVIA_CHANNEL_ENDPOINT, {
              method: "POST",
              headers: { "Content-Type": "application/json" },
              body: JSON.stringify(payload),
            });
            const apiAnswer = await response.json().catch(() => null);
            if (!response.ok) {
              throw new Error(apiAnswer?.error || apiAnswer?.detail || "Olivia API error");
            }

            const answer = getAssistantText(apiAnswer);
            if (!answer) throw new Error("Olivia API returned an empty answer");

            addAssistantMessageWithTyping(answer, {
              whatsapp: apiAnswer?.handoffRecommended === true,
            });
            persistInboxAssistant(answer).catch(() => {});
          } catch {
            addAssistantMessageWithTyping(copy.apiError);
          } finally {
            if (submitButton) submitButton.disabled = false;
          }
        }

        form?.addEventListener("submit", async (event) => {
          event.preventDefault();
          submitOliviaMessage();
        });
      })();
    </script>
      </>
    )}
  </body>
</html>
